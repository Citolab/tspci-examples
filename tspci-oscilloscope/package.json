{
  "name": "@citolab/pci-oscilloscope",
  "version": "1.0.0-beta.1",
  "description": "an oscilloscope screen: the candidate sets frequency and amplitude of a signal next to a reference signal",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "oscilloscope",
    "physics",
    "sound",
    "frequency",
    "amplitude"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-oscilloscope"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "oscilloscope.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-oscilloscope npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-oscilloscope npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "oscilloscope",
      "label": "Oscilloscope",
      "tags": [
        "physics",
        "sound",
        "oscilloscope",
        "frequency",
        "amplitude"
      ],
      "scoring": [
        "custom",
        "match_correct",
        "human"
      ],
      "correctResponse": "properties",
      "short": "oscilloscope",
      "response": {
        "cardinality": "ordered",
        "baseType": "float"
      },
      "authoring": {
        "label": {
          "en": "Set up the signals…",
          "nl": "Signalen instellen…"
        },
        "width": 960,
        "height": 640
      }
    }
  }
}
