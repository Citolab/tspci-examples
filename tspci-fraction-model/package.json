{
  "name": "@citolab/pci-fraction-model",
  "version": "1.0.0-alpha.1",
  "description": "fractions and percentages with models: a bar (strip) with a percentage scale, a circle, a grid and a set; the candidate divides and shades parts, or names the shaded fraction",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "fraction",
    "percentage",
    "math",
    "fraction-bar",
    "pie-chart"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-fraction-model"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "fractionModel.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-fraction-model npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-fraction-model npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "fractionModel",
      "label": "Fraction model",
      "tags": [
        "fraction",
        "percentage",
        "math",
        "model"
      ],
      "scoring": [
        "match_correct",
        "custom",
        "human"
      ],
      "short": "fractionModel",
      "response": {
        "$comment": "One value per model, in order: the shaded (or typed) fraction in lowest terms, \"3/8\"; \"\" for an empty entry. With data-scoring=\"pci\" a record instead (README).",
        "cardinality": "ordered",
        "baseType": "string"
      },
      "correctResponse": "properties",
      "authoring": {
        "label": {
          "en": "Set up the models…",
          "nl": "Modellen instellen…"
        },
        "width": 1000,
        "height": 720
      }
    }
  }
}
