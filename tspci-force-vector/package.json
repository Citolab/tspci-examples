{
  "name": "@citolab/pci-force-vector",
  "version": "1.0.0-beta.1",
  "description": "draw a force arrow from a point on a picture, with a force scale, a ruler and a live label; scored like the rubric",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "physics",
    "force",
    "vector",
    "arrow",
    "forces"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-force-vector"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "forceVector.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-force-vector npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-force-vector npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "forceVector",
      "label": "Force vector",
      "tags": [
        "physics",
        "forces",
        "vector",
        "drawing"
      ],
      "scoring": [
        "custom",
        "match_correct",
        "human"
      ],
      "short": "forceVector",
      "correctResponse": "properties",
      "response": {
        "cardinality": "ordered",
        "baseType": "float",
        "$comment": "four floats per arrow, in the order of data-arrows: x, y of the start (cm from the top left), direction (degrees counter-clockwise from the right), length (cm); an arrow not drawn is x, y, 0, 0. The README has the response processing for the rubric"
      },
      "authoring": {
        "label": {
          "en": "Draw the correct arrows…",
          "nl": "Goede pijlen tekenen…"
        },
        "width": 1100,
        "height": 760
      }
    }
  }
}
