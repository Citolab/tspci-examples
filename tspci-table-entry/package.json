{
  "name": "@citolab/pci-table-entry",
  "version": "1.0.0-beta.1",
  "description": "fill in the table: given cells and input cells with expected values, scored per cell",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "table",
    "fill in the table",
    "math",
    "data"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-table-entry"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "tableEntry.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-table-entry npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-table-entry npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "tableEntry",
      "label": "Table entry",
      "tags": [
        "table",
        "fill in the table",
        "math",
        "data"
      ],
      "scoring": [
        "match_correct",
        "custom",
        "human"
      ],
      "short": "tableEntry",
      "response": {
        "$comment": "One value per input cell, in reading order, normalized (1,5 → 1.5); \"\" for an empty cell. With data-scoring=\"pci\" a record instead (README).",
        "cardinality": "ordered",
        "baseType": "string"
      },
      "correctResponse": "properties",
      "authoring": {
        "label": {
          "en": "Build the table…",
          "nl": "Tabel maken…"
        },
        "width": 1000,
        "height": 680
      }
    }
  }
}
