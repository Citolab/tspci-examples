{
  "name": "@citolab/pci-spreadsheet",
  "version": "1.0.0-alpha.2",
  "description": "a small spreadsheet with formulas: answer in a cell, or use it as a tool",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "spreadsheet",
    "formulas",
    "math",
    "data"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-spreadsheet"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "spreadsheet.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-spreadsheet npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-spreadsheet npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "spreadsheet",
      "label": "Spreadsheet",
      "tags": [
        "spreadsheet",
        "formulas",
        "math",
        "data"
      ],
      "scoring": [
        "match_correct",
        "human"
      ],
      "short": "spreadsheet",
      "response": {
        "cardinality": "single",
        "baseType": "string"
      },
      "authoring": {
        "label": {
          "en": "Set up the sheet…",
          "nl": "Werkblad inrichten…"
        },
        "width": 1000,
        "height": 700
      }
    }
  }
}
