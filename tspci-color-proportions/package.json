{
  "name": "@citolab/pci-verhoudingen",
  "version": "1.1.0",
  "description": "color the proportions of the colors in the image",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-color-proportions"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "colorProportions.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "2.14.0",
    "@citolab/tspci": "2.14.0",
    "@citolab/tspci-qti3": "2.14.0",
    "@citolab/tspci-tao": "2.14.0",
    "@react-hook/mouse-position": "^4.1.3",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "set ROLLUP_WATCH=true && tspci --dev",
    "prod": "tspci",
    "watch": "tspci --watch",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "colorProportions",
      "label": "verhoudingen",
      "score": [
        "MATCH_CORRECT",
        "NONE"
      ],
      "short": "verhoudingen",
      "response": {
        "cardinality": "single",
        "baseType": "string"
      },
      "authoring": {
        "label": {
          "en": "Draw the shape…",
          "nl": "Vorm tekenen…"
        },
        "width": 960,
        "height": 760
      }
    }
  }
}
