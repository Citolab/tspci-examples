{
  "name": "@citolab/pci-chance-tools",
  "version": "1.0.0-alpha.1",
  "description": "probability experiments with dice, a spinner, a bag of balls and coins: run trials, design a spinner or bag for a given probability, or fill in a probability tree",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "probability",
    "chance",
    "dice",
    "spinner",
    "probability-tree",
    "statistics"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-chance-tools"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "chanceTools.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-chance-tools npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-chance-tools npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "chanceTools",
      "label": "Chance tools",
      "tags": [
        "probability",
        "chance",
        "dice",
        "spinner",
        "statistics"
      ],
      "scoring": [
        "custom",
        "human"
      ],
      "short": "chanceTools",
      "response": {
        "cardinality": "record",
        "$comment": "Design and tree mode: this record, scored by the PCI (CUSTOM). Tool mode (score NONE): a single string, the experiment log as JSON; declare the response single/string (README)",
        "fields": {
          "score": {
            "baseType": "integer",
            "label": {
              "en": "Score: points of the checks that pass",
              "nl": "Score: punten van de checks die kloppen"
            }
          },
          "maxscore": {
            "baseType": "integer",
            "label": {
              "en": "Maximum score: points of all checks",
              "nl": "Maximale score: punten van alle checks"
            }
          },
          "correct": {
            "baseType": "integer",
            "label": {
              "en": "Correct: 1 when every check passes",
              "nl": "Goed: 1 als alle checks kloppen"
            }
          },
          "target1": {
            "baseType": "integer",
            "label": {
              "en": "Design: target 1, 1 met, 0 not",
              "nl": "Ontwerp: doel 1, 1 gehaald, 0 niet"
            }
          },
          "probability1": {
            "baseType": "string",
            "label": {
              "en": "Design: the probability of the outcome of target 1, in lowest terms (3/8)",
              "nl": "Ontwerp: de kans op de uitkomst van doel 1, vereenvoudigd (3/8)"
            }
          },
          "value1": {
            "baseType": "float",
            "label": {
              "en": "Design: the probability of target 1 as a number",
              "nl": "Ontwerp: de kans van doel 1 als getal"
            },
            "tolerance": "range"
          },
          "target2": {
            "baseType": "integer",
            "label": {
              "en": "Design: target 2, 1 met, 0 not",
              "nl": "Ontwerp: doel 2, 1 gehaald, 0 niet"
            }
          },
