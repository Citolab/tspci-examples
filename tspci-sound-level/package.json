{
  "name": "@citolab/pci-sound-level",
  "version": "1.0.0-beta.1",
  "description": "a sound source and a listener: choose the power and the distance and read the sound level in dB",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "sound",
    "decibel",
    "physics",
    "simulation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-sound-level"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "soundLevel.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/three": "0.180.0",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18",
    "three": "0.180.0"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-sound-level npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-sound-level npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "soundLevel",
      "label": "Sound level",
      "tags": [
        "sound",
        "decibel",
        "physics",
        "simulation"
      ],
      "scoring": [
        "match_correct",
        "human"
      ],
      "short": "soundLevel",
      "correctResponse": "properties",
      "response": {
        "cardinality": "single",
        "baseType": "float",
        "tolerance": "range",
        "$comment": "Answer mode (data-mode=\"answer\"): the distance or power the candidate set, a float. Tool mode: the settings the candidate tried, as a JSON string: declare the response string and score NONE (README)"
      }
    }
  }
}
