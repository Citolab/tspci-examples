{
  "name": "@citolab/pci-data-chart",
  "version": "1.0.0-beta.1",
  "description": "an interactive data chart (bar, stacked, line, pie): the details on hover or focus, as a tool or to click the answer",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "chart",
    "bar chart",
    "graph",
    "data",
    "statistics"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-data-chart"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "dataChart.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-data-chart npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-data-chart npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "dataChart",
      "label": "Data chart",
      "tags": [
        "chart",
        "graph",
        "data",
        "statistics"
      ],
      "scoring": [
        "match_correct",
        "human"
      ],
      "short": "dataChart",
      "response": {
        "cardinality": "single",
        "baseType": "identifier",
        "$comment": "select mode with data-max-choices 1; more choices: cardinality multiple; tool mode (score NONE): a string, the segments the candidate looked at, as JSON (README)"
      },
      "correctResponse": "properties",
      "authoring": {
        "label": {
          "en": "Edit the chart data…",
          "nl": "Grafiekgegevens bewerken…"
        },
        "width": 1040,
        "height": 720
      }
    }
  }
}
