{
  "name": "@citolab/pci-q-sort",
  "version": "1.0.0-beta.1",
  "description": "a Q-sort: place statements in a forced, quasi-normal grid from most disagree to most agree, horizontal or vertical, with an optional pre-sort into three piles; based on openPCI WordRank",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "contributors": [
    "Elias J.T. Hansen",
    "Anna Rusmann <andr@hum.aau.dk>",
    "Jeppe Bundsgaard <jebu@edu.au.dk>"
  ],
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "q-sort",
    "q methodology",
    "ranking",
    "drag and drop",
    "openpci"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-q-sort"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "qSort.svg",
    "example.png",
    "README.md",
    "AUTHORING.md",
    "LICENSE"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-q-sort npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-q-sort npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "qSort",
      "label": "Q-sort",
      "tags": [
        "q-sort",
        "q methodology",
        "ranking",
        "drag and drop"
      ],
      "scoring": [
        "none"
      ],
      "short": "qSort",
      "response": {
        "cardinality": "single",
        "baseType": "string"
      }
    }
  }
}
