{
  "name": "@citolab/pci-number-line",
  "version": "1.0.0-alpha.1",
  "description": "a number line (getallenlijn): place points, mark an interval, draw jumps for addition and subtraction, or read off values; integers, decimals, fractions and negatives",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "number-line",
    "getallenlijn",
    "math",
    "arithmetic",
    "fractions"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-number-line"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "numberLine.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-number-line npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-number-line npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "numberLine",
      "label": "Number line",
      "tags": [
        "math",
        "number line",
        "arithmetic",
        "fractions"
      ],
      "scoring": [
        "match_correct",
        "custom",
        "human"
      ],
      "short": "numberLine",
      "correctResponse": "properties",
      "response": {
        "cardinality": "ordered",
        "baseType": "float",
        "tolerance": "range",
        "$comment": "points: one float per point, in the order of data-task; read: one float per value to read off; jumps: the start and every landing; reported once complete. Interval mode: a single string, [-2,inf) (declare cardinality single, base-type string). data-scoring=\"pci\": a record with score, maxscore, correct, check1…check8 and answer (README)"
      },
      "authoring": {
        "label": {
          "en": "Set up the number line…",
          "nl": "Getallenlijn instellen…"
        },
        "width": 1100,
        "height": 780
      }
    }
  }
}
