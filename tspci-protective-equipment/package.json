{
  "name": "@citolab/pci-protective-equipment",
  "version": "1.0.0-alpha.1",
  "description": "personal protective equipment (persoonlijke beschermingsmiddelen, PBM) for VCA safety training: dress a drawn worker for a job with the right equipment and no more, by dragging or tapping, and optionally say why for each item",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples/tree/main/tspci-protective-equipment#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-protective-equipment"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "protectiveEquipment.svg",
    "example.png",
    "README.md",
    "AUTHORING.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.3",
    "@citolab/tspci": "3.1.0",
    "@citolab/tspci-qti3": "3.1.0",
    "@citolab/tspci-tao": "3.1.0",
    "@tailwindcss/nesting": "0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "4.3.5",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "postcss-import": "16.2.0",
    "preact": "10.29.8",
    "tailwindcss": "4.3.5",
    "tslib": "2.9.1"
  },
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "protective-equipment",
    "ppe",
    "persoonlijke-beschermingsmiddelen",
    "pbm",
    "vca",
    "safety",
    "veiligheid",
    "praktijkonderwijs"
  ],
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test \"test/*.test.ts\"",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-protective-equipment npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-protective-equipment npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "protectiveEquipment",
      "label": "Protective equipment",
      "tags": [
        "safety",
        "vca",
        "ppe",
        "vocational"
      ],
      "short": "protectiveEquipment",
      "scoring": [
        "custom",
        "match_correct",
        "human"
      ],
      "correctResponse": "properties",
      "response": {
        "cardinality": "record",
        "fields": {
          "required": {
            "baseType": "integer",
            "label": {
              "en": "Required equipment worn (one of the alternatives counts once)",
              "nl": "Verplichte beschermingsmiddelen gedragen (één van de alternatieven telt één keer)"
            }
          },
          "requiredTotal": {
            "baseType": "integer",
            "label": {
              "en": "Required equipment in total",
              "nl": "Verplichte beschermingsmiddelen in totaal"
            }
          },
          "wrong": {
            "baseType": "integer",
            "label": {
              "en": "Equipment worn that this job does not need",
              "nl": "Gedragen beschermingsmiddelen die dit werk niet nodig heeft"
            }
          },
          "correct": {
            "baseType": "boolean",
            "label": {
              "en": "Everything required, nothing that is not needed",
              "nl": "Alles wat verplicht is, niets wat niet nodig is"
            }
          },
          "items": {
            "baseType": "string",
            "label": {
              "en": "The equipment worn (ids, comma separated)",
              "nl": "De gedragen beschermingsmiddelen (ids, gescheiden door komma's)"
            }
          },
          "reasons": {
            "baseType": "string",
            "label": {
              "en": "Why, per item worn (item:hazard, comma separated)",
              "nl": "Waarom, per gedragen middel (middel:gevaar, gescheiden door komma's)"
            },
            "when": {
              "explain": [
                "true"
              ]
            }
          },
          "reasonsRight": {
            "baseType": "integer",
            "label": {
              "en": "Items worn with a reason that fits this job",
              "nl": "Gedragen middelen met een reden die bij dit werk past"
            },
            "when": {
              "explain": [
                "true"
              ]
            }
          },
          "reasonsCorrect": {
            "baseType": "boolean",
            "label": {
              "en": "Every item worn has a reason that fits this job",
              "nl": "Elk gedragen middel heeft een reden die bij dit werk past"
            },
            "when": {
              "explain": [
                "true"
              ]
            }
          }
        }
      },
      "authoring": {
        "label": {
          "en": "Job and equipment…",
          "nl": "Werk en beschermingsmiddelen…"
        },
        "width": 960,
        "height": 900
      }
    }
  }
}
