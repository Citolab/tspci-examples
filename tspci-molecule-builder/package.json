{
  "name": "@citolab/pci-molecule-builder",
  "version": "1.0.0-alpha.1",
  "description": "build molecules from atoms and bonds, in 3D (ball-and-stick, VSEPR) or as a structural formula; scored on a canonical SMILES or by checks",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "chemistry",
    "molecule",
    "structural-formula",
    "3d"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-molecule-builder"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "moleculeBuilder.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/three": "0.180.0",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18",
    "three": "0.180.0"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-molecule-builder npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-molecule-builder npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "moleculeBuilder",
      "label": "Molecule builder",
      "tags": [
        "chemistry",
        "molecule",
        "structural formula",
        "3d"
      ],
      "scoring": [
        "match_correct",
        "custom",
        "human"
      ],
      "short": "moleculeBuilder",
      "correctResponse": "properties",
      "response": {
        "$comment": "The molecule as \"formula:SMILES\" (Hill formula, canonical SMILES), the same however it was drawn: \"H2O:O\". With data-scoring=\"pci\" a record with the checks instead (README).",
        "cardinality": "single",
        "baseType": "string"
      },
      "authoring": {
        "label": {
          "en": "Build the molecule…",
          "nl": "Molecuul bouwen…"
        },
        "width": 1100,
        "height": 760
      }
    }
  }
}
