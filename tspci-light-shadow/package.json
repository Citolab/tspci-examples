{
  "name": "@citolab/pci-light-shadow",
  "version": "1.0.0-alpha.1",
  "description": "light and shadow in 3D: move lamps and an object in front of a screen; the PCI computes the shadow, umbra and penumbra exactly and scores them against the author's targets",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "light",
    "shadow",
    "umbra",
    "penumbra",
    "optics",
    "physics",
    "three"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-light-shadow"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "lightShadow.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/three": "0.180.0",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18",
    "three": "0.180.0"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-light-shadow npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-light-shadow npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "lightShadow",
      "label": "Light and shadow",
      "tags": [
        "light",
        "shadow",
        "optics",
        "physics",
        "3d"
      ],
      "scoring": [
        "custom",
        "human"
      ],
      "short": "lightShadow",
      "correctResponse": "properties",
      "response": {
        "cardinality": "record",
        "$comment": "The positions the candidate set and the shadow the PCI computes (cm); in answer mode also the author's targets (data-scene) evaluated; README",
        "fields": {
          "score": {
            "baseType": "integer",
            "label": {
              "en": "Score: points of the targets met",
              "nl": "Score: punten van de doelen die gehaald zijn"
            }
          },
          "maxscore": {
            "baseType": "integer",
            "label": {
              "en": "Maximum score: points of all targets",
              "nl": "Maximale score: punten van alle doelen"
            }
          },
          "correct": {
            "baseType": "integer",
            "label": {
              "en": "Correct: 1 when every target is met",
              "nl": "Goed: 1 als elk doel gehaald is"
            }
          },
          "check1": {
            "baseType": "integer",
            "label": {
              "en": "Target 1: 1 met, 0 not",
              "nl": "Doel 1: 1 gehaald, 0 niet"
            }
          },
          "check2": {
            "baseType": "integer",
            "label": {
              "en": "Target 2: 1 met, 0 not",
              "nl": "Doel 2: 1 gehaald, 0 niet"
            }
          },
          "check3": {
            "baseType": "integer",
            "label": {
              "en": "Target 3: 1 met, 0 not",
              "nl": "Doel 3: 1 gehaald, 0 niet"
            }
          },
          "check4": {
            "baseType": "integer",
            "label": {
              "en": "Target 4: 1 met, 0 not",
              "nl": "Doel 4: 1 gehaald, 0 niet"
            }
          },
          "shadowHeight": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Height of the whole shadow (cm)",
              "nl": "Hoogte van de hele schaduw (cm)"
            }
          },
          "shadowWidth": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Width of the whole shadow (cm)",
              "nl": "Breedte van de hele schaduw (cm)"
            }
          },
          "umbraHeight": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Height of the umbra (cm)",
              "nl": "Hoogte van de kernschaduw (cm)"
            }
          },
          "umbraWidth": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Width of the umbra (cm)",
              "nl": "Breedte van de kernschaduw (cm)"
            }
          },
          "penumbraHeight": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Penumbra, vertically, both bands together (cm)",
              "nl": "Halfschaduw, verticaal, beide stroken samen (cm)"
            }
          },
          "penumbraWidth": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Penumbra, horizontally, both bands together (cm)",
              "nl": "Halfschaduw, horizontaal, beide stroken samen (cm)"
            }
          },
          "magnification": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Shadow height / object height",
              "nl": "Schaduwhoogte / voorwerphoogte"
            }
          },
          "lamp1Distance": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Lamp 1: distance to the screen (cm)",
              "nl": "Lamp 1: afstand tot het scherm (cm)"
            }
          },
          "lamp1Height": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Lamp 1: height (cm)",
              "nl": "Lamp 1: hoogte (cm)"
            }
          },
          "lamp1Side": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Lamp 1: sideways from the middle (cm)",
              "nl": "Lamp 1: opzij van het midden (cm)"
            }
          },
          "lamp2Distance": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Lamp 2: distance to the screen (cm)",
              "nl": "Lamp 2: afstand tot het scherm (cm)"
            }
          },
          "lamp2Height": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Lamp 2: height (cm)",
              "nl": "Lamp 2: hoogte (cm)"
            }
          },
          "lamp2Side": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Lamp 2: sideways from the middle (cm)",
              "nl": "Lamp 2: opzij van het midden (cm)"
            }
          },
          "objectDistance": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Object: distance to the screen (cm)",
              "nl": "Voorwerp: afstand tot het scherm (cm)"
            }
          },
          "tried": {
            "baseType": "string",
            "label": {
              "en": "Tool mode: every position the candidate stopped at (JSON)",
              "nl": "Gereedschap: elke stand waar de kandidaat stopte (JSON)"
            }
          }
        }
      },
      "authoring": {
        "label": {
          "en": "Set up the scene…",
          "nl": "Opstelling maken…"
        },
        "width": 1100,
        "height": 800
      }
    }
  }
}
