              "nl": "Jaar van gebeurtenis 10 (v.Chr. negatief, geen jaar 0)"
            }
          },
          "year11": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Year of event 11 (BC negative, no year 0)",
              "nl": "Jaar van gebeurtenis 11 (v.Chr. negatief, geen jaar 0)"
