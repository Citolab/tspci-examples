            }
          },
          "period10": {
            "baseType": "identifier",
            "label": {
              "en": "Period of event 10",
              "nl": "Tijdvak van gebeurtenis 10"
            }
          },
          "period11": {
            "baseType": "identifier",
            "label": {
              "en": "Period of event 11",
              "nl": "Tijdvak van gebeurtenis 11"
            }
          },
          "period12": {
            "baseType": "identifier",
            "label": {
              "en": "Period of event 12",
              "nl": "Tijdvak van gebeurtenis 12"
            }
          },
          "order": {
            "baseType": "string",
            "label": {
              "en": "Order: the event ids from early to late",
              "nl": "Volgorde: de ids van de gebeurtenissen van vroeg naar laat"
            }
          },
          "pairs": {
            "baseType": "integer",
            "label": {
              "en": "Pairs in the right order (order mode)",
              "nl": "Paren in de goede volgorde (volgorde)"
            }
          },
          "placements": {
            "baseType": "string",
            "label": {
              "en": "Placements: every event with its year or period (JSON)",
              "nl": "Plaatsing: elke gebeurtenis met jaar of tijdvak (JSON)"
            }
          }
        }
      },
      "authoring": {
        "label": {
          "en": "Make the timeline…",
          "nl": "Tijdbalk maken…"
        },
        "width": 1100,
        "height": 780
      }
    }
  }
}
