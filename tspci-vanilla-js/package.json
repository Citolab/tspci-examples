{
  "name": "@citolab/vanilla-js",
  "description": "Vanilla js pci",
  "version": "1.1.0",
  "main": "dist/index.js",
  "types": "dist/types.d.ts",
  "devDependencies": {
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qbci": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1"
  },
  "scripts": {
    "tscpi": "tspci --help",
    "dev": "tspci --dev",
    "preprod": "npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "package-tao": "tspci --target tao",
    "package-qb": "tspci --target qbci",
    "package-qti3": "tspci --target qti3",
    "storybook": "cd .. && TSPCI_STORIES=tspci-vanilla-js npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-vanilla-js npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "HelloWorld",
      "label": "Percentages",
      "response": {
        "cardinality": "single",
        "baseType": "integer"
      },
      "scoring": [
        "match_correct",
        "human"
      ],
      "short": "HW"
    }
  },
  "source": "src/index.ts"
}
