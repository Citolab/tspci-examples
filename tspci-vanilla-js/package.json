{
  "name": "@citolab/vanilla-js",
  "description": "Vanilla js pci",
  "version": "1.1.0",
  "main": "dist/index.js",
  "types": "dist/types.d.ts",
  "devDependencies": {
    "@citolab/tspci": "2.13.0",
    "@citolab/tspci-qbci": "2.13.0",
    "@citolab/tspci-tao": "2.13.0",
    "@citolab/tspci-qti3": "2.13.0"
  },
  "scripts": {
    "tscpi": "tspci --help",
    "dev": "tspci --dev",
    "prod": "tspci",
    "watch": "tspci --watch",
    "package-tao": "tspci --target tao",
    "package-qb": "tspci --target qbci",
    "package-qti3": "tspci --target qti3"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "HelloWorld",
      "label": "Percentages",
      "response": {
        "cardinality": "single",
        "baseType": "integer"
      },
      "score": [
        "MATCH_CORRECT",
        "NONE"
      ],
      "short": "HW"
    }
  },
  "source": "src/index.ts"
}
