{
  "name": "@citolab/pci-money",
  "version": "1.0.0-alpha.2",
  "description": "money (rekenen met geld): pay an amount exactly or in as few coins and notes as possible, give change, count the money on a counter, or work a cash register (ring up the shopping, take the payment, give the change), with stylised coins and notes in euro, dollar, pound or a currency of the author's",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples/tree/main/tspci-money#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-money"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "money.svg",
    "example.png",
    "README.md",
    "AUTHORING.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.3",
    "@citolab/tspci": "3.1.0",
    "@citolab/tspci-qti3": "3.1.0",
    "@citolab/tspci-tao": "3.1.0",
    "@tailwindcss/nesting": "0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "4.3.5",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "postcss-import": "16.2.0",
    "preact": "10.29.8",
    "tailwindcss": "4.3.5",
    "tslib": "2.9.1"
  },
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "money",
    "geld",
    "rekenen-met-geld",
    "euro",
    "dollar",
    "pound",
    "currency",
    "change",
    "wisselgeld",
    "math",
    "cash-register",
    "kassa",
    "retail"
  ],
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test \"test/*.test.ts\"",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-money npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-money npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "money",
      "label": "Money",
      "tags": [
        "math",
        "money",
        "euro",
        "dollar",
        "pound",
        "change",
        "cash-register"
      ],
      "short": "money",
      "scoring": [
        "match_correct",
        "custom",
        "human"
      ],
      "correctResponse": "properties",
      "response": {
        "cardinality": "record",
        "fields": {
          "amount": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Amount on the counter (in the main unit: euros, dollars, pounds)",
              "nl": "Bedrag op de toonbank (in de hoofdeenheid: euro, dollar, pond)"
            },
            "when": {
              "task": [
                "pay",
                "fewest",
                "change",
                "changeFewest"
              ]
            }
          },
          "answer": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Amount written (in the main unit: euros, dollars, pounds)",
              "nl": "Geschreven bedrag (in de hoofdeenheid: euro, dollar, pond)"
            },
            "when": {
              "task": [
                "count"
              ]
            }
          },
          "exact": {
            "baseType": "boolean",
            "label": {
              "en": "The amount is the one asked",
              "nl": "Het bedrag is het gevraagde bedrag"
            },
            "when": {
              "task": [
                "pay",
                "fewest",
                "change",
                "changeFewest",
                "count"
              ]
            }
          },
          "pieces": {
            "baseType": "integer",
            "label": {
              "en": "Number of coins and notes",
              "nl": "Aantal munten en biljetten"
            },
            "when": {
              "task": [
                "fewest",
                "changeFewest"
              ]
            }
          },
          "itemsRungUp": {
            "baseType": "integer",
            "label": {
              "en": "Items rung up (all quantities together)",
              "nl": "Aangeslagen artikelen (alle aantallen samen)"
            },
            "when": {
              "task": [
                "register"
              ]
            }
          },
          "itemsTotal": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "What the items rung up cost, with the deals (main unit)",
              "nl": "Wat de aangeslagen artikelen kosten, met de acties (hoofdeenheid)"
            },
            "when": {
              "task": [
                "register"
              ]
            }
          },
          "total": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Total on the till: calculated, or keyed in by the pupil (main unit; 0 before Total)",
              "nl": "Totaal op de kassa: uitgerekend, of ingetoetst door de leerling (hoofdeenheid; 0 voor Totaal)"
            },
            "when": {
              "task": [
                "register"
              ]
            }
          },
          "totalCorrect": {
            "baseType": "boolean",
            "label": {
              "en": "The total is what the customer has to pay",
              "nl": "Het totaal is wat de klant moet betalen"
            },
            "when": {
              "task": [
                "register"
              ]
            }
          },
          "paid": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Keyed in as paid by the customer (main unit; 0 before Cash)",
              "nl": "Ingetoetst als betaald door de klant (hoofdeenheid; 0 voor Contant)"
            },
            "when": {
              "task": [
                "register"
              ]
            }
          },
          "change": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Change given to the customer (main unit)",
              "nl": "Wisselgeld gegeven aan de klant (hoofdeenheid)"
            },
            "when": {
              "task": [
                "register"
              ]
            }
          },
          "changeCorrect": {
            "baseType": "boolean",
            "label": {
              "en": "The change is right",
              "nl": "Het wisselgeld klopt"
            },
            "when": {
              "task": [
                "register"
              ]
            }
          },
          "fewest": {
            "baseType": "boolean",
            "label": {
              "en": "As few coins and notes as possible for this amount (register: the change)",
              "nl": "Zo weinig mogelijk munten en biljetten voor dit bedrag (kassa: het wisselgeld)"
            },
            "when": {
              "task": [
                "fewest",
                "changeFewest",
                "register"
              ]
            }
          },
          "correct": {
            "baseType": "boolean",
            "label": {
              "en": "Everything right: the shopping rung up, the total, the payment, the change (in the fewest pieces when asked)",
              "nl": "Alles goed: de boodschappen aangeslagen, het totaal, de betaling, het wisselgeld (in zo weinig mogelijk stukken als dat gevraagd is)"
            },
            "when": {
              "task": [
                "register"
              ]
            }
          }
        }
      },
      "authoring": {
        "label": {
          "en": "Coins, notes and shopping…",
          "nl": "Munten, biljetten en boodschappen…"
        },
        "width": 960,
        "height": 900
      }
    }
  }
}
