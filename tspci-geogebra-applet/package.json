{
  "name": "@citolab/pci-geogebra-applet",
  "version": "1.0.0-beta.1",
  "description": "a GeoGebra applet in a QTI item: the candidate constructs, the applet can score itself",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "LicenseRef-GeoGebra",
  "contributors": [
    "Jean-Philippe Rivière, Wiquid (original GeoGebra PCI GGBPCI in janfix/extension-geogebra)"
  ],
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "geogebra",
    "geometry",
    "graphing",
    "mathematics"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-geogebra-applet"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "geogebraApplet.svg",
    "example.png",
    "LICENSE",
    "README.md",
    "AUTHORING.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-geogebra-applet npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-geogebra-applet npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "geogebraApplet",
      "label": "GeoGebra applet",
      "tags": [
        "geogebra",
        "geometry",
        "graphing",
        "mathematics"
      ],
      "scoring": [
        "custom",
        "human"
      ],
      "short": "geogebraApplet",
      "response": {
        "cardinality": "record",
        "$comment": "Read from the applet's objects named correct, answer, score and maxscore (README); applet only with data-save-applet",
        "fields": {
          "correct": {
            "baseType": "integer",
            "label": {
              "en": "Correct (object correct: 1 or 0)",
              "nl": "Goed (object correct: 1 of 0)"
            }
          },
          "candidateResponse": {
            "baseType": "string",
            "label": {
              "en": "Answer (object answer)",
              "nl": "Antwoord (object answer)"
            }
          },
          "score": {
            "baseType": "integer",
            "label": {
              "en": "Score (object score)",
              "nl": "Score (object score)"
            }
          },
          "maxscore": {
            "baseType": "integer",
            "label": {
              "en": "Maximum score (object maxscore)",
              "nl": "Maximale score (object maxscore)"
            }
          },
          "applet": {
            "baseType": "string",
            "label": {
              "en": "The candidate's applet (base64 .ggb)",
              "nl": "De applet van de kandidaat (base64 .ggb)"
            }
          }
        }
      },
      "authoring": {
        "label": {
          "en": "Build the applet…",
          "nl": "Applet maken…"
        },
        "width": 1100,
        "height": 760
      },
      "sbom": {
        "additionalComponents": [
          {
            "name": "GeoGebra Math Apps (deployggb.js)",
            "publisher": "GeoGebra GmbH",
            "license": "LicenseRef-GeoGebra",
            "description": "Loaded at runtime from geogebra.org, not bundled; licence: https://www.geogebra.org/license",
            "externalReferences": [
              {
                "type": "distribution",
                "url": "https://www.geogebra.org/apps/deployggb.js"
              },
              {
                "type": "license",
                "url": "https://www.geogebra.org/license"
              }
            ]
          }
        ]
      }
    }
  }
}
