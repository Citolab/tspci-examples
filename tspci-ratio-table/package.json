{
  "name": "ratio-table",
  "description": "Verhoudingstabel",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/types.d.ts",
  "private": true,
  "dependencies": {
    "preact": "^10.24.0",
    "@citolab/preact-store": "latest"
  },
  "devDependencies": {
    "@citolab/tspci": "latest",
    "@citolab/tspci-qti3": "latest",
    "tslib": "^2.8.1",
    "postcss-import": "^16.1.1",
    "@tailwindcss/nesting": "0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "10.4.23",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "prod": "tspci",
    "tspci": "tspci",
    "package:qti3": "tspci --target qti3",
    "storybook": "cd .. && TSPCI_STORIES=tspci-ratio-table npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-ratio-table npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "ratioTable",
      "label": "Verhoudingstabel",
      "response": {
        "cardinality": "single",
        "baseType": "integer"
      },
      "scoring": [
        "match_correct",
        "human"
      ]
    }
  },
  "source": "src/index.tsx",
  "author": "45795"
}