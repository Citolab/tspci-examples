{
  "name": "ratio-table",
  "description": "Verhoudingstabel",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/types.d.ts",
  "private": true,
  "dependencies": {
    "preact": "^10.24.0",
    "@citolab/preact-store": "latest"
  },
  "devDependencies": {
    "@citolab/tspci": "latest",
    "@citolab/tspci-qti3": "latest",
    "tslib": "^2.8.1",
    "postcss-import": "^16.1.1",
    "@tailwindcss/nesting": "0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "10.4.23",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "prod": "tspci",
    "tspci": "tspci",
    "package:qti3": "tspci --target qti3",
    "storybook": "cd .. && TSPCI_STORIES=tspci-ratio-table npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-ratio-table npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "ratioTable",
      "label": "Verhoudingstabel",
      "response": {
        "cardinality": "record",
        "fields": {
          "answer": { "baseType": "float", "tolerance": "range", "label": { "en": "Answer", "nl": "Antwoord" }, "when": { "mode": ["answer", "working"] } },
          "working": { "baseType": "boolean", "label": { "en": "The working is correct", "nl": "De uitwerking klopt" }, "when": { "mode": ["answer", "working"] } },
          "answerCorrect": { "baseType": "boolean", "label": { "en": "The answer is correct", "nl": "Het antwoord is goed" }, "when": { "mode": ["working"] } },
          "ratio": { "baseType": "boolean", "label": { "en": "Every column has the same ratio", "nl": "Elke kolom heeft dezelfde verhouding" }, "when": { "mode": ["working"] } },
          "steps": { "baseType": "boolean", "label": { "en": "Every step on an arrow is right", "nl": "Elke stap bij een pijl klopt" }, "when": { "mode": ["working"] } },
          "stepsMatch": { "baseType": "boolean", "label": { "en": "The steps below are the steps above", "nl": "De stappen onder zijn de stappen boven" }, "when": { "mode": ["working"] } }
        }
      },
      "toolWhen": { "mode": ["tool"] },
      "correctResponse": "properties",
      "media": {
        "roboto400": { "file": "src/fonts/roboto-latin-400-normal.woff2", "mode": "inline" },
        "roboto500": { "file": "src/fonts/roboto-latin-500-normal.woff2", "mode": "inline" },
        "roboto900": { "file": "src/fonts/roboto-latin-900-normal.woff2", "mode": "inline" }
      },
      "scoring": [
        "custom",
        "match_correct",
        "human"
      ]
    }
  },
  "source": "src/index.tsx",
  "author": "45795"
}