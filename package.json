    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "preact": "^10.28.2",
    "storybook": "^10.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
