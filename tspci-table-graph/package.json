{
  "name": "@citolab/pci-table-graph",
  "version": "1.0.0",
  "description": "find where two formulas meet, with a table and a graph of the values the candidate adds",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "math",
    "algebra",
    "graphs",
    "linear relations",
    "tables"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-table-graph"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "tableGraph.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "2.14.0",
    "@citolab/tspci": "2.15.0",
    "@citolab/tspci-qti3": "2.14.0",
    "@citolab/tspci-tao": "2.15.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "set ROLLUP_WATCH=true && tspci --dev",
    "prod": "tspci",
    "watch": "tspci --watch",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "tableGraph",
      "label": "Table and graph",
      "tags": [
        "math",
        "algebra",
        "graphs",
        "linear relations",
        "tables"
      ],
      "role": "tool",
      "score": [
        "NONE"
      ],
      "short": "tableGraph",
      "response": {
        "cardinality": "ordered",
        "baseType": "float"
      }
    }
  }
}
