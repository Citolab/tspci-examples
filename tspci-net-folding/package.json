{
  "name": "@citolab/pci-net-folding",
  "version": "1.0.0-alpha.1",
  "description": "nets of solids: build a net that folds into a cube or a box, find opposite and adjacent faces, complete a net, pick the nets that fold; the net folds in 3D",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "net",
    "cube",
    "spatial-reasoning",
    "geometry",
    "three"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-net-folding"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "netFolding.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/three": "0.180.0",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18",
    "three": "0.180.0"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-net-folding npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-net-folding npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "netFolding",
      "label": "Net folding",
      "tags": [
        "net",
        "cube",
        "solid",
        "spatial",
        "geometry",
        "3d"
      ],
      "scoring": [
        "match_correct",
        "custom",
        "human"
      ],
      "short": "netFolding",
      "response": {
        "cardinality": "multiple",
        "baseType": "identifier",
        "$comment": "opposite, adjacent and folds modes: face or net identifiers (f3, n2); complete: face-label pairs (f2-A); build mode (score CUSTOM): a record with score, maxscore, correct, closed, overlap, gaps, faces and net (README)"
      },
      "correctResponse": "properties",
      "authoring": {
        "label": {
          "en": "Draw the nets…",
          "nl": "Uitslagen tekenen…"
        },
        "width": 1100,
        "height": 780
      }
    }
  }
}
