  "mode": {
    "default": "read",
    "editor": "pci",
    "label": {
      "en": "Task",
      "nl": "Opdracht"
    },
    "options": [
      {
        "value": "read",
        "label": {
          "en": "Read off: type the value",
          "nl": "Aflezen: de waarde typen"
        }
      },
      {
        "value": "set",
        "label": {
          "en": "Set: drag to the value",
