    }
  },
  "value": {
    "default": "",
    "editor": "pci",
    "label": {
      "en": "Value shown, to set or to expect",
      "nl": "Waarde die het aangeeft, in te stellen of te verwachten"
    },
    "$comment": "read: what the instrument shows; set: the value to set; range: the value the candidate expects. A clock: minutes after 12 o'clock (635 is 10:35). Also the correct response (getCorrectResponse)"
  },
  "precision": {
    "default": "",
    "editor": "pci",
    "label": {
      "en": "Reading precision (empty: one division)",
      "nl": "Afleesnauwkeurigheid (leeg: één streepje)"
