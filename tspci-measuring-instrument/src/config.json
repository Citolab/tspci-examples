  },
  "min": {
    "default": "",
    "editor": "pci",
    "label": {
      "en": "Scale from (empty: the instrument's)",
      "nl": "Schaal van (leeg: van het instrument)"
    }
  },
  "max": {
    "default": "",
    "editor": "pci",
    "label": {
      "en": "Scale to (empty: the instrument's)",
      "nl": "Schaal tot (leeg: van het instrument)"
    }
  },
  "major": {
    "default": "",
    "editor": "pci",
    "label": {
      "en": "A number at every …",
      "nl": "Een getal bij elke …"
    }
  },
  "minor": {
    "default": "",
    "editor": "pci",
    "label": {
