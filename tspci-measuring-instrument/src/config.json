  "zoom": {
    "default": "true",
    "editor": "boolean",
    "label": {
      "en": "Magnifier on hover and focus",
      "nl": "Vergrootglas bij muis en focus"
    }
  },
  "tolerance": {
    "default": "0",
    "editor": "pci",
    "label": {
      "en": "Margin for the score (0: exact)",
      "nl": "Marge voor de score (0: precies)"
    },
    "$comment": "only for the response processing the authoring mode writes; delivery does not use it"
  },
  "language": {
    "default": "en",
    "editor": "enum",
    "options": [
      {
        "value": "en",
        "label": {
