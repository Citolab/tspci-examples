      {
        "value": "20",
        "label": {
          "en": "20 divisions (0.05 mm)",
          "nl": "20 streepjes (0,05 mm)"
        }
      },
      {
        "value": "50",
        "label": {
          "en": "50 divisions (0.02 mm)",
          "nl": "50 streepjes (0,02 mm)"
        }
      }
    ]
