{
  "name": "@citolab/pci-measuring-instrument",
  "version": "1.0.0-alpha.1",
  "description": "read off or set measuring instruments drawn in SVG: thermometer, measuring cylinder, volt- and ammeter, kitchen scale, ruler, vernier caliper, clock, stopwatch and pressure gauge",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "measuring",
    "instrument",
    "physics",
    "thermometer",
    "voltmeter",
    "vernier"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-measuring-instrument"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "measuringInstrument.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-measuring-instrument npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-measuring-instrument npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "measuringInstrument",
      "label": "Measuring instrument",
      "tags": [
        "physics",
        "measuring",
        "instrument",
        "scale",
        "units"
      ],
      "scoring": [
        "match_correct",
        "custom",
        "human"
      ],
      "short": "measuringInstrument",
      "correctResponse": "properties",
      "response": {
        "cardinality": "single",
        "baseType": "float",
        "tolerance": "range",
        "$comment": "read: the number the candidate typed; set: the value the candidate set; range: the range chosen. In the unit of the instrument (a clock: minutes after 12 o'clock), the same in every language. The README has the response processing with a margin"
      },
      "authoring": {
        "label": {
          "en": "Set up the instrument…",
          "nl": "Meetinstrument instellen…"
        },
        "width": 1100,
        "height": 760
      }
    }
  }
}
