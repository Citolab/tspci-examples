{
  "name": "@citolab/pci-flowchart",
  "version": "1.0.0-alpha.2",
  "description": "build or complete a flowchart: put cards in order, fill the slots of a partial chart, or build freely; the PCI scores the graph layout independently",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "flowchart",
    "process",
    "decision-tree",
    "algorithm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-flowchart"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "flowchart.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-flowchart npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-flowchart npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "flowchart",
      "label": "Flowchart",
      "tags": [
        "flowchart",
        "process",
        "decision tree",
        "algorithm"
      ],
      "scoring": [
        "match_correct",
        "custom",
        "human"
      ],
      "short": "flowchart",
      "response": {
        "$comment": "data-scoring=\"match\" (default): the graph as a canonical string (single string, MATCH_CORRECT). data-scoring=\"pci\": a record with the checks (CUSTOM). README",
        "cardinality": "single",
        "baseType": "string"
      },
      "authoring": {
        "label": {
          "en": "Make the flowchart…",
          "nl": "Stroomschema maken…"
        },
        "width": 1100,
        "height": 780
      },
      "correctResponse": "properties"
    }
  }
}
