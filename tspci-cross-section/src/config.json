      "en": "Instruction above the solid",
      "nl": "Instructie boven de ruimtefiguur"
    }
  },
  "solid": {
    "default": "cube",
    "editor": "enum",
    "options": [
      {
        "value": "cube",
        "label": {
          "en": "Cube",
          "nl": "Kubus"
        }
      },
      {
        "value": "box",
        "label": {
          "en": "Box (cuboid)",
          "nl": "Balk"
        }
      },
      {
        "value": "prism",
        "label": {
          "en": "Prism (regular base)",
          "nl": "Prisma (regelmatig grondvlak)"
        }
      },
      {
        "value": "pyramid",
        "label": {
          "en": "Pyramid (regular base)",
          "nl": "Piramide (regelmatig grondvlak)"
        }
      },
      {
        "value": "cylinder",
        "label": {
          "en": "Cylinder",
          "nl": "Cilinder"
        }
      },
      {
        "value": "cone",
        "label": {
          "en": "Cone",
          "nl": "Kegel"
        }
      },
      {
        "value": "sphere",
        "label": {
          "en": "Sphere",
          "nl": "Bol"
        }
      }
    ],
    "label": {
      "en": "Solid",
      "nl": "Ruimtefiguur"
    }
  },
  "dimensions": {
    "default": "6",
    "editor": "text",
    "label": {
      "en": "Dimensions in cm: cube edge; box length width height; prism/pyramid side height; cylinder/cone radius height; sphere radius",
      "nl": "Afmetingen in cm: kubus ribbe; balk lengte breedte hoogte; prisma/piramide zijde hoogte; cilinder/kegel straal hoogte; bol straal"
    }
  },
  "baseSides": {
    "default": "4",
    "editor": "integer",
    "min": 3,
    "max": 8,
    "label": {
      "en": "Sides of the base of a prism or pyramid",
      "nl": "Zijden van het grondvlak van een prisma of piramide"
    }
  },
  "mode": {
    "default": "answer",
    "editor": "enum",
    "options": [
      {
        "value": "answer",
        "label": {
          "en": "Answer: the section is scored against the target",
          "nl": "Antwoord: de doorsnede wordt gescoord tegen het doel"
        }
      },
      {
        "value": "tool",
        "label": {
          "en": "Tool: explore, not scored",
          "nl": "Hulpmiddel: verkennen, niet gescoord"
        }
      }
    ],
    "label": {
      "en": "Mode",
      "nl": "Modus"
    }
  },
  "controls": {
    "default": "move tilt turn handles points hide",
    "editor": "text",
    "label": {
      "en": "Controls the candidate gets: move tilt turn handles points hide (empty: the plane is fixed)",
      "nl": "Bediening voor de kandidaat: move tilt turn handles points hide (leeg: het vlak ligt vast)"
    }
  },
  "plane": {
    "default": "0 0 0",
    "editor": "text",
    "label": {
      "en": "Start plane: offset (cm) tilt (°) turn (°)",
      "nl": "Beginvlak: verschuiving (cm) helling (°) draaiing (°)"
    }
  },
  "solutionPlane": {
    "default": "0 54.7356 45",
    "editor": "pci",
    "label": {
      "en": "A plane that answers the question (shown as the solution)",
      "nl": "Een vlak dat de vraag beantwoordt (getoond als oplossing)"
