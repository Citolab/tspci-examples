{
  "name": "@citolab/pci-circuit-builder",
  "version": "1.0.0-beta.1",
  "description": "complete a circuit diagram on a grid: drag symbols and wires, the PCI checks the circuit (closed, series, parallel, polarity)",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "circuit",
    "electricity",
    "physics",
    "circuit-diagram"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-circuit-builder"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "circuitBuilder.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-circuit-builder npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-circuit-builder npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "circuitBuilder",
      "label": "Circuit builder",
      "tags": [
        "circuit",
        "electricity",
        "physics",
        "diagram"
      ],
      "scoring": [
        "custom",
        "human"
      ],
      "short": "circuitBuilder",
      "response": {
        "cardinality": "record",
        "$comment": "The PCI evaluates the author's checks (data-circuit); README",
        "fields": {
          "score": {
            "baseType": "integer",
            "label": {
              "en": "Score: points of the passed checks",
              "nl": "Score: punten van de checks die kloppen"
            }
          },
          "maxscore": {
            "baseType": "integer",
            "label": {
              "en": "Maximum score: points of all checks",
              "nl": "Maximale score: punten van alle checks"
            }
          },
          "correct": {
            "baseType": "integer",
            "label": {
              "en": "Correct: 1 when every check passes",
              "nl": "Goed: 1 als alle checks kloppen"
            }
          },
          "check1": {
            "baseType": "integer",
            "label": {
              "en": "Check 1: 1 passed, 0 not",
              "nl": "Check 1: 1 klopt, 0 niet"
            }
          },
          "check2": {
            "baseType": "integer",
            "label": {
              "en": "Check 2: 1 passed, 0 not",
              "nl": "Check 2: 1 klopt, 0 niet"
            }
          },
          "check3": {
            "baseType": "integer",
            "label": {
              "en": "Check 3: 1 passed, 0 not",
              "nl": "Check 3: 1 klopt, 0 niet"
            }
          },
          "check4": {
            "baseType": "integer",
            "label": {
              "en": "Check 4: 1 passed, 0 not",
              "nl": "Check 4: 1 klopt, 0 niet"
            }
          },
          "check5": {
            "baseType": "integer",
            "label": {
              "en": "Check 5: 1 passed, 0 not",
              "nl": "Check 5: 1 klopt, 0 niet"
            }
          },
          "check6": {
            "baseType": "integer",
            "label": {
              "en": "Check 6: 1 passed, 0 not",
              "nl": "Check 6: 1 klopt, 0 niet"
            }
          },
          "check7": {
            "baseType": "integer",
            "label": {
              "en": "Check 7: 1 passed, 0 not",
              "nl": "Check 7: 1 klopt, 0 niet"
            }
          },
          "check8": {
            "baseType": "integer",
            "label": {
              "en": "Check 8: 1 passed, 0 not",
              "nl": "Check 8: 1 klopt, 0 niet"
            }
          },
          "topology": {
            "baseType": "string",
            "label": {
              "en": "Topology: the circuit without its layout",
              "nl": "Topologie: de schakeling zonder de plaatsing"
            }
          },
          "board": {
            "baseType": "string",
            "label": {
              "en": "Board: every part on the grid (JSON)",
              "nl": "Bord: alle onderdelen op het rooster (JSON)"
            }
          }
        }
      },
      "authoring": {
        "label": {
          "en": "Build the circuit…",
          "nl": "Schakeling maken…"
        },
        "width": 1100,
        "height": 760
      }
    }
  }
}
