{
  "name": "@citolab/pci-the-room",
  "version": "1.0.0-alpha.0",
  "description": "furnish and arrange a 3D room; based on The Room 3D by openPCI (Aarhus and Aalborg University)",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "contributors": [
    "Elias J.T. Hansen",
    "Anna Rusmann",
    "Jeppe Bundsgaard",
    "openPCI (Aarhus University and Aalborg University)"
  ],
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "3d",
    "design",
    "spatial reasoning",
    "openpci"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-the-room"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "theroom.svg",
    "example.png",
    "LICENSE",
    "README.md",
    "AUTHORING.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/three": "0.180.0",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18",
    "three": "0.180.0"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-the-room npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-the-room npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "theroom",
      "label": "The Room 3D",
      "tags": [
        "3d",
        "design",
        "spatial reasoning"
      ],
      "scoring": [
        "custom",
        "human"
      ],
      "short": "theroom",
      "response": {
        "cardinality": "single",
        "baseType": "string"
      }
    }
  }
}
