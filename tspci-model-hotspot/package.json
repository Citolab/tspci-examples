{
  "name": "@citolab/pci-model-hotspot",
  "version": "1.0.0-alpha.1",
  "description": "click or label the parts of a rotatable 3D model (eye, flower, plant cell, bicycle, or a glTF): scored with MATCH_CORRECT on part identifiers or label pairs",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "3d",
    "hotspot",
    "biology",
    "technology",
    "labelling"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-model-hotspot"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "modelHotspot.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/three": "0.180.0",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18",
    "three": "0.180.0"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test test/",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-model-hotspot npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-model-hotspot npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "modelHotspot",
      "label": "3D model hotspot",
      "tags": [
        "3d",
        "hotspot",
        "biology",
        "technology",
        "label"
      ],
      "scoring": [
        "match_correct",
        "human"
      ],
      "short": "modelHotspot",
      "response": {
        "cardinality": "single",
        "baseType": "identifier",
        "$comment": "click mode with data-cardinality single; multiple: cardinality multiple, baseType identifier; label mode: cardinality multiple, baseType directedPair (label part); README"
      },
      "correctResponse": "properties",
      "authoring": {
        "label": {
          "en": "Set up the model…",
          "nl": "Model instellen…"
        },
        "width": 1100,
        "height": 780
      }
    }
  }
}
