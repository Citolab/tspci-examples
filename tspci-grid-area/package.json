{
  "name": "@citolab/pci-grid-area",
  "version": "1.0.0-alpha.1",
  "description": "area and perimeter on squared paper (oppervlakte en omtrek op ruitjespapier): draw a shape with a given area or perimeter, measure the author's shape, or compare two shapes; whole and half squares, checked by rules; and cover a floor (een kamer stofferen): the area, strips of carpet off a roll, and the bill",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples/tree/main/tspci-grid-area#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-grid-area"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "gridArea.svg",
    "example.png",
    "README.md",
    "AUTHORING.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.3",
    "@citolab/tspci": "3.1.0",
    "@citolab/tspci-qti3": "3.1.0",
    "@citolab/tspci-tao": "3.1.0",
    "@tailwindcss/nesting": "0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "4.3.5",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "postcss-import": "16.2.0",
    "preact": "10.29.8",
    "tailwindcss": "4.3.5",
    "tslib": "2.9.1"
  },
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "area",
    "perimeter",
    "oppervlakte",
    "omtrek",
    "squared-paper",
    "math",
    "floor-covering",
    "stofferen"
  ],
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test \"test/*.test.ts\"",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-grid-area npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-grid-area npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "gridArea",
      "label": "Area and perimeter",
      "tags": [
        "math",
        "area",
        "perimeter",
        "measurement",
        "geometry"
      ],
      "short": "gridArea",
      "scoring": [
        "custom",
        "match_correct",
        "human"
      ],
      "correctResponse": "properties",
      "response": {
        "cardinality": "record",
        "fields": {
          "area": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Area (draw: in squares; cover: the floor area written, in m²)",
              "nl": "Oppervlakte (tekenen: in hokjes; stofferen: de ingevulde oppervlakte van de vloer, in m²)"
            },
            "when": {
              "task": [
                "draw",
                "cover"
              ]
            }
          },
          "perimeter": {
            "baseType": "float",
            "label": {
              "en": "Perimeter (only without diagonal sides)",
              "nl": "Omtrek (alleen zonder schuine zijden)"
            },
            "when": {
              "task": [
                "draw"
              ]
            }
          },
          "connected": {
            "baseType": "boolean",
            "label": {
              "en": "The shape is one piece",
              "nl": "De figuur is één geheel"
            },
            "when": {
              "task": [
                "draw"
              ]
            }
          },
          "noHoles": {
            "baseType": "boolean",
            "label": {
              "en": "The shape has no holes",
              "nl": "De figuur heeft geen gaten"
            },
            "when": {
              "task": [
                "draw"
              ]
            }
          },
          "rectangle": {
            "baseType": "boolean",
            "label": {
              "en": "The shape is a rectangle",
              "nl": "De figuur is een rechthoek"
            },
            "when": {
              "task": [
                "draw"
              ]
            }
          },
          "meetsRules": {
            "baseType": "boolean",
            "label": {
              "en": "The shape meets the rules",
              "nl": "De figuur voldoet aan de regels"
            },
            "when": {
              "task": [
                "draw"
              ]
            }
          },
          "shape": {
            "baseType": "string",
            "label": {
              "en": "The drawn shape",
              "nl": "De getekende figuur"
            },
            "when": {
              "task": [
                "draw"
              ]
            }
          },
          "areaAnswer": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Area answered",
              "nl": "Ingevulde oppervlakte"
            },
            "when": {
              "task": [
                "measure"
              ],
              "ask": [
                "area",
                "both"
              ]
            }
          },
          "perimeterAnswer": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Perimeter answered",
              "nl": "Ingevulde omtrek"
            },
            "when": {
              "task": [
                "measure"
              ],
              "ask": [
                "perimeter",
                "both"
              ]
            }
          },
          "choice": {
            "baseType": "identifier",
            "label": {
              "en": "The shape chosen (A, B or same)",
              "nl": "De gekozen figuur (A, B of same)"
            },
            "when": {
              "task": [
                "compare"
              ]
            }
          },
          "areaCorrect": {
            "baseType": "boolean",
            "label": {
              "en": "The floor area is right",
              "nl": "De oppervlakte van de vloer is goed"
            },
            "when": {
              "task": [
                "cover"
              ]
            }
          },
          "covered": {
            "baseType": "boolean",
            "label": {
              "en": "The strips cover the whole floor",
              "nl": "De banen bedekken de hele vloer"
            },
            "when": {
              "task": [
                "cover"
              ]
            }
          },
          "waste": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Waste (m²): strips off the floor or twice on it",
              "nl": "Afval (m²): banen naast de vloer of dubbel erop"
            },
            "when": {
              "task": [
                "cover"
              ]
            }
          },
          "runningMetres": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Running metres of the strips",
              "nl": "Strekkende meters van de banen"
            },
            "when": {
              "task": [
                "cover"
              ]
            }
          },
          "leastWaste": {
            "baseType": "boolean",
            "label": {
              "en": "The floor is covered with the least waste",
              "nl": "De vloer is bedekt met het minste afval"
            },
            "when": {
              "task": [
                "cover"
              ]
            }
          },
          "strips": {
            "baseType": "string",
            "label": {
              "en": "The plan of strips",
              "nl": "Het plan met banen"
            },
            "when": {
              "task": [
                "cover"
              ]
            }
          },
          "billCorrect": {
            "baseType": "boolean",
            "label": {
              "en": "Every line of the bill is right for the plan and the prices",
              "nl": "Elke regel van de rekening klopt bij het plan en de prijzen"
            },
            "when": {
              "task": [
                "cover"
              ]
            }
          },
          "total": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "The total written (euros)",
              "nl": "Het ingevulde totaal (euro)"
            },
            "when": {
              "task": [
                "cover"
              ]
            }
          },
          "totalCorrect": {
            "baseType": "boolean",
            "label": {
              "en": "The total adds up the pupil's own amounts",
              "nl": "Het totaal telt de eigen bedragen van de leerling op"
            },
            "when": {
              "task": [
                "cover"
              ]
            }
          },
          "bill": {
            "baseType": "string",
            "label": {
              "en": "The lines of the bill written",
              "nl": "De ingevulde regels van de rekening"
            },
            "when": {
              "task": [
                "cover"
              ]
            }
          },
          "correct": {
            "baseType": "boolean",
            "label": {
              "en": "Everything asked is right",
              "nl": "Alles wat gevraagd is, is goed"
            },
            "when": {
              "task": [
                "cover"
              ]
            }
          }
        }
      },
      "authoring": {
        "label": {
          "en": "Draw the shapes or the room…",
          "nl": "Figuren of de kamer tekenen…"
        },
        "width": 960,
        "height": 760
      }
    }
  }
}
