{
  "name": "@citolab/pci-grid-area",
  "version": "1.0.0-alpha.1",
  "description": "area and perimeter on squared paper (oppervlakte en omtrek op ruitjespapier): draw a shape with a given area or perimeter, measure the author's shape, or compare two shapes; whole and half squares, checked by rules",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples/tree/main/tspci-grid-area#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-grid-area"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "gridArea.svg",
    "example.png",
    "README.md",
    "AUTHORING.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.3",
    "@citolab/tspci": "3.1.0",
    "@citolab/tspci-qti3": "3.1.0",
    "@citolab/tspci-tao": "3.1.0",
    "@tailwindcss/nesting": "0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "4.3.5",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "postcss-import": "16.2.0",
    "preact": "10.29.8",
    "tailwindcss": "4.3.5",
    "tslib": "2.9.1"
  },
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "area",
    "perimeter",
    "oppervlakte",
    "omtrek",
    "squared-paper",
    "math"
  ],
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test \"test/*.test.ts\"",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-grid-area npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-grid-area npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "gridArea",
      "label": "Area and perimeter",
      "tags": [
        "math",
        "area",
        "perimeter",
        "measurement",
        "geometry"
      ],
      "short": "gridArea",
      "scoring": [
        "custom",
        "match_correct",
        "human"
      ],
      "correctResponse": "properties",
      "response": {
        "cardinality": "record",
        "fields": {
          "area": {
            "baseType": "float",
            "label": {
              "en": "Area (squares)",
              "nl": "Oppervlakte (hokjes)"
            },
            "when": {
              "task": [
                "draw"
              ]
            }
          },
          "perimeter": {
            "baseType": "float",
            "label": {
              "en": "Perimeter (only without diagonal sides)",
              "nl": "Omtrek (alleen zonder schuine zijden)"
            },
            "when": {
              "task": [
                "draw"
              ]
            }
          },
          "connected": {
            "baseType": "boolean",
            "label": {
              "en": "The shape is one piece",
              "nl": "De figuur is één geheel"
            },
            "when": {
              "task": [
                "draw"
              ]
            }
          },
          "noHoles": {
            "baseType": "boolean",
            "label": {
              "en": "The shape has no holes",
              "nl": "De figuur heeft geen gaten"
            },
            "when": {
              "task": [
                "draw"
              ]
            }
          },
          "rectangle": {
            "baseType": "boolean",
            "label": {
              "en": "The shape is a rectangle",
              "nl": "De figuur is een rechthoek"
            },
            "when": {
              "task": [
                "draw"
              ]
            }
          },
          "meetsRules": {
            "baseType": "boolean",
            "label": {
              "en": "The shape meets the rules",
              "nl": "De figuur voldoet aan de regels"
            },
            "when": {
              "task": [
                "draw"
              ]
            }
          },
          "shape": {
            "baseType": "string",
            "label": {
              "en": "The drawn shape",
              "nl": "De getekende figuur"
            },
            "when": {
              "task": [
                "draw"
              ]
            }
          },
          "areaAnswer": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Area answered",
              "nl": "Ingevulde oppervlakte"
            },
            "when": {
              "task": [
                "measure"
              ],
              "ask": [
                "area",
                "both"
              ]
            }
          },
          "perimeterAnswer": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "Perimeter answered",
              "nl": "Ingevulde omtrek"
            },
            "when": {
              "task": [
                "measure"
              ],
              "ask": [
                "perimeter",
                "both"
              ]
            }
          },
          "choice": {
            "baseType": "identifier",
            "label": {
              "en": "The shape chosen (A, B or same)",
              "nl": "De gekozen figuur (A, B of same)"
            },
            "when": {
              "task": [
                "compare"
              ]
            }
          }
        }
      },
      "authoring": {
        "label": {
          "en": "Draw the shapes…",
          "nl": "Figuren tekenen…"
        },
        "width": 960,
        "height": 760
      }
    }
  }
}
