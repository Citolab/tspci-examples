{
  "name": "@citolab/pci-table-select",
  "version": "1.0.0-alpha.1",
  "description": "select the right row or cell in a table the author builds",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "table",
    "reading tables",
    "data"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-table-select"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "tableSelect.svg",
    "example.png",
    "README.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-table-select npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-table-select npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "tableSelect",
      "label": "Table select",
      "tags": [
        "table",
        "reading tables",
        "data"
      ],
      "scoring": [
        "match_correct",
        "human"
      ],
      "short": "tableSelect",
      "response": {
        "cardinality": "single",
        "baseType": "identifier"
      },
      "authoring": {
        "label": {
          "en": "Build the table…",
          "nl": "Tabel maken…"
        },
        "width": 960,
        "height": 640
      }
    }
  }
}
