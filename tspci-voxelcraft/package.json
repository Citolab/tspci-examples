{
  "name": "@citolab/pci-voxelcraft",
  "version": "1.0.0-beta.1",
  "description": "build anything out of cubes in 3d, a port of openPCI's Voxelcraft",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "contributors": [
    "OpenPCI, Aarhus University and Aalborg University: Elias J.T. Hansen, Anna Rusmann, Jeppe Bundsgaard (https://github.com/openPCI/openPCIs)"
  ],
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "3d",
    "voxels",
    "spatial reasoning",
    "openpci"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-voxelcraft"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "voxelcraft.svg",
    "example.png",
    "README.md",
    "AUTHORING.md",
    "LICENSE"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/three": "0.180.0",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18",
    "three": "0.180.0"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-voxelcraft npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-voxelcraft npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "voxelcraft",
      "label": "Voxelcraft",
      "tags": [
        "3d",
        "voxels",
        "spatial reasoning"
      ],
      "scoring": [
        "match_correct",
        "human"
      ],
      "short": "voxelcraft",
      "sbom": {
        "supplier": {
          "name": "Citolab",
          "url": "https://github.com/Citolab"
        },
        "externalReferences": [
          {
            "type": "issue-tracker",
            "url": "https://github.com/Citolab/tspci-examples/issues"
          },
          {
            "type": "vcs",
            "url": "https://github.com/openPCI/openPCIs/tree/master/voxelcraft"
          }
        ]
      },
      "response": {
        "cardinality": "single",
        "baseType": "string"
      },
      "authoring": {
        "label": {
          "en": "Build the figures…",
          "nl": "Figuren bouwen…"
        },
        "width": 960,
        "height": 680
      }
    }
  }
}
