{
  "name": "@citolab/pci-brainstorm",
  "version": "1.0.0-alpha.0",
  "description": "a simulated brainstorm chat with scripted participants; a port of the openPCI brainstorm PCI",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "contributors": [
    "Elias J.T. Hansen (openPCI, Aarhus University)",
    "Anna Rusmann <andr@hum.aau.dk> (openPCI, Aalborg University)",
    "Jeppe Bundsgaard <jebu@edu.au.dk> (openPCI, Aarhus University)"
  ],
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Citolab/tspci-examples#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "brainstorm",
    "chat",
    "collaboration",
    "openpci"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-brainstorm"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "brainstorm.svg",
    "example.png",
    "LICENSE",
    "README.md",
    "AUTHORING.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.1",
    "@citolab/tspci": "3.0.1",
    "@citolab/tspci-qti3": "3.0.1",
    "@citolab/tspci-tao": "3.0.1",
    "@tailwindcss/postcss": "^4.1.18",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "preact": "10.28.2",
    "tailwindcss": "^4.1.18"
  },
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-brainstorm npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-brainstorm npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "brainstorm",
      "label": "Brainstorm",
      "tags": [
        "brainstorm",
        "chat",
        "collaboration"
      ],
      "scoring": [
        "human"
      ],
      "short": "brainstorm",
      "response": {
        "cardinality": "single",
        "baseType": "string"
      }
    }
  }
}
