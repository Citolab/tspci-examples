{
  "name": "@citolab/pci-document-reading",
  "version": "1.0.0-alpha.1",
  "description": "documents lezen: functional reading and arithmetic with a realistic but fictitious document (a payslip, a till receipt, a packing slip next to a delivery, a staff rota, a bus timetable, an energy bill, a dosage table); the pupil taps a field, taps the mistakes, or answers a question with a number",
  "author": {
    "name": "Citolab",
    "url": "https://github.com/Citolab"
  },
  "license": "MIT",
  "homepage": "https://github.com/Citolab/tspci-examples/tree/main/tspci-document-reading#readme",
  "bugs": "https://github.com/Citolab/tspci-examples/issues",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Citolab/tspci-examples.git",
    "directory": "tspci-document-reading"
  },
  "files": [
    "dist/index.js",
    "dist/authoring.json",
    "dist/sbom.cdx.json",
    "dist/tao-pci-*.zip",
    "documentReading.svg",
    "example.png",
    "README.md",
    "AUTHORING.md"
  ],
  "source": "src/index.tsx",
  "main": "dist/index.js",
  "devDependencies": {
    "@citolab/preact-store": "3.0.3",
    "@citolab/tspci": "3.1.0",
    "@citolab/tspci-qti3": "3.1.0",
    "@citolab/tspci-tao": "3.1.0",
    "@tailwindcss/nesting": "0.0.0-insiders.565cd3e",
    "@tailwindcss/postcss": "4.3.5",
    "archiver": "7.0.1",
    "autoprefixer": "10.4.23",
    "postcss-import": "16.2.0",
    "preact": "10.29.8",
    "tailwindcss": "4.3.5",
    "tslib": "2.9.1"
  },
  "keywords": [
    "qti",
    "qti3",
    "pci",
    "portable-custom-interaction",
    "tspci",
    "document-reading",
    "documenten-lezen",
    "functional-literacy",
    "functional-numeracy",
    "payslip",
    "loonstrook",
    "praktijkonderwijs"
  ],
  "scripts": {
    "dev": "tspci --dev",
    "preprod": "npm test && npm run test:stories",
    "prod": "tspci",
    "watch": "tspci --watch",
    "test": "node --no-warnings --test \"test/*.test.ts\"",
    "package-tao": "tspci --target tao",
    "package-qti3": "tspci --target qti3",
    "prepack": "npm run prod && npm run package-tao",
    "storybook": "cd .. && TSPCI_STORIES=tspci-document-reading npx storybook dev -p 6006",
    "test:stories": "cd .. && TSPCI_STORIES=tspci-document-reading npx vitest run --project=storybook"
  },
  "config": {
    "tspci": {
      "typeIdentifier": "documentReading",
      "label": "Document reading",
      "tags": [
        "functional literacy",
        "numeracy",
        "reading",
        "money"
      ],
      "short": "documentReading",
      "scoring": [
        "custom",
        "match_correct",
        "human"
      ],
      "correctResponse": "properties",
      "response": {
        "cardinality": "record",
        "fields": {
          "correct": {
            "baseType": "boolean",
            "label": {
              "en": "Correct: the right field, every mistake and nothing else, or the right number",
              "nl": "Goed: het juiste veld, elke fout en niets anders, of het juiste getal"
            }
          },
          "field": {
            "baseType": "identifier",
            "label": {
              "en": "The field the pupil tapped",
              "nl": "Het veld waarop de leerling tikte"
            },
            "when": {
              "task": [
                "find"
              ]
            }
          },
          "found": {
            "baseType": "integer",
            "tolerance": "range",
            "label": {
              "en": "Mistakes found",
              "nl": "Gevonden fouten"
            },
            "when": {
              "task": [
                "check"
              ]
            }
          },
          "total": {
            "baseType": "integer",
            "label": {
              "en": "Mistakes in the document",
              "nl": "Fouten in het document"
            },
            "when": {
              "task": [
                "check"
              ]
            }
          },
          "wrong": {
            "baseType": "integer",
            "tolerance": "range",
            "label": {
              "en": "Taps on a field without a mistake",
              "nl": "Tikken op een veld zonder fout"
            },
            "when": {
              "task": [
                "check"
              ]
            }
          },
          "mistake1": {
            "baseType": "boolean",
            "label": {
              "en": "Mistake 1 found",
              "nl": "Fout 1 gevonden"
            },
            "when": {
              "task": [
                "check"
              ]
            }
          },
          "mistake2": {
            "baseType": "boolean",
            "label": {
              "en": "Mistake 2 found",
              "nl": "Fout 2 gevonden"
            },
            "when": {
              "task": [
                "check"
              ]
            }
          },
          "mistake3": {
            "baseType": "boolean",
            "label": {
              "en": "Mistake 3 found",
              "nl": "Fout 3 gevonden"
            },
            "when": {
              "task": [
                "check"
              ]
            }
          },
          "mistake4": {
            "baseType": "boolean",
            "label": {
              "en": "Mistake 4 found",
              "nl": "Fout 4 gevonden"
            },
            "when": {
              "task": [
                "check"
              ]
            }
          },
          "mistake5": {
            "baseType": "boolean",
            "label": {
              "en": "Mistake 5 found",
              "nl": "Fout 5 gevonden"
            },
            "when": {
              "task": [
                "check"
              ]
            }
          },
          "mistake6": {
            "baseType": "boolean",
            "label": {
              "en": "Mistake 6 found",
              "nl": "Fout 6 gevonden"
            },
            "when": {
              "task": [
                "check"
              ]
            }
          },
          "mistake7": {
            "baseType": "boolean",
            "label": {
              "en": "Mistake 7 found",
              "nl": "Fout 7 gevonden"
            },
            "when": {
              "task": [
                "check"
              ]
            }
          },
          "mistake8": {
            "baseType": "boolean",
            "label": {
              "en": "Mistake 8 found",
              "nl": "Fout 8 gevonden"
            },
            "when": {
              "task": [
                "check"
              ]
            }
          },
          "answer": {
            "baseType": "float",
            "tolerance": "range",
            "label": {
              "en": "The number the pupil typed",
              "nl": "Het getal dat de leerling typte"
            },
            "when": {
              "task": [
                "answer"
              ]
            }
          },
          "source": {
            "baseType": "identifier",
            "label": {
              "en": "Where the pupil found it (the field they marked)",
              "nl": "Waar de leerling het vond (het gemarkeerde veld)"
            },
            "when": {
              "task": [
                "answer"
              ]
            }
          },
          "sourceCorrect": {
            "baseType": "boolean",
            "label": {
              "en": "The marked field is where the answer is",
              "nl": "Het gemarkeerde veld is waar het antwoord staat"
            },
            "when": {
              "task": [
                "answer"
              ]
            }
          }
        }
      },
      "authoring": {
        "label": {
          "en": "Make the document…",
          "nl": "Document maken…"
        },
        "width": 960,
        "height": 860
      }
    }
  }
}
